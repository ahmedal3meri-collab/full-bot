# UAE Services Hub — انسخ إلى .env واملأ كل CHANGE_ME
# ولّد أسرارًا عشوائية: openssl rand -base64 48

# ---------- التطبيق ----------
NODE_ENV=development
APP_URL=http://localhost:3000
# نطاقك الحقيقي للإنتاج (Caddy + SSL) — راجع REQUIRED_USER_INPUT.md #1
APP_DOMAIN=CHANGE_ME.example.com

# ---------- PostgreSQL ----------
POSTGRES_USER=ush
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ush_production
# محليًا بدون Docker: postgresql://user:pass@127.0.0.1:5432/db?schema=public
# داخل docker-compose: يُبنى تلقائيًا من المتغيرات أعلاه (راجع docker-compose.yml)
DATABASE_URL=postgresql://ush:CHANGE_ME@localhost:5432/ush_production?schema=public

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# ---------- Qdrant (المرحلة 5 — RAG) ----------
QDRANT_API_KEY=CHANGE_ME
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ush_knowledge

# ---------- MinIO (تخزين الصور/الملفات) ----------
MINIO_ROOT_USER=ush_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
S3_ENDPOINT=http://minio:9000
S3_BUCKET_LISTINGS=listings
S3_BUCKET_DOCS=documents

# ---------- Realtime ----------
REALTIME_PORT=4000

# ---------- OTP / SMS (راجع REQUIRED_USER_INPUT.md #2) ----------
# console = يطبع الكود باللوغ بدل الإرسال الفعلي (وضع التطوير الافتراضي)
OTP_PROVIDER=console
# عند اختيار مزود حقيقي (unifonic | twilio):
# UNIFONIC_APP_SID=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---------- SMTP (راجع REQUIRED_USER_INPUT.md #5) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="UAE Services Hub <no-reply@example.com>"

# ---------- الدفع (راجع REQUIRED_USER_INPUT.md #3) — لا مفاتيح حقيقية هنا أبدًا ----------
PAYMENT_PROVIDER=
TELR_STORE_ID=
TELR_AUTH_KEY=
# NETWORK_INTERNATIONAL_...
# CHECKOUT_COM_SECRET_KEY=

# ---------- الذكاء الاصطناعي (المرحلة 5 — راجع REQUIRED_USER_INPUT.md #4) ----------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# أو Ollama محلي:
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:32b
EMBEDDINGS_PROVIDER=
EMBEDDINGS_BASE_URL=

# ---------- Google Login (اختياري) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- النسخ الاحتياطي ----------
BACKUP_DIR=/var/backups/ush
BACKUP_RETAIN_DAYS=14
BACKUP_GPG_RECIPIENT=

# ---------- المراقبة (اختياري) ----------
SENTRY_DSN=
